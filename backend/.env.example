PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
# Optional local DNS override when the system resolver refuses Atlas SRV lookups.
# Leave unset on Render/production.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4

ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret
REFRESH_TOKEN_EXPIRY=7d

# SMTP settings for verification OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=Eventora <your_email@gmail.com>

NODE_ENV=development
FRONTEND_URL=http://localhost:5173
